# --- 텔레그램(Telethon) 로그인 정보 ---
# https://my.telegram.org → API development tools 에서 발급
TG_API_ID=
TG_API_HASH=
# 세션 파일 이름(처음 1회 로그인하면 이 이름으로 .session 파일이 생김)
TG_SESSION=digest

# --- Gemini ---
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 대상 채널 ---
# (권장) 텔레그램 채팅 폴더 이름. 채우면 그 폴더의 채널을 자동으로 씀(CHANNELS 무시).
FOLDER=

# FOLDER 를 비웠을 때만 사용. 쉼표로 구분.
# 예: @channel_username,@another_channel,-1001234567890
CHANNELS=

# 최근 몇 시간을 가져올지
HOURS=24

# 채널당 이미지 최대 개수(토큰 절약)
MAX_IMAGES_PER_CHANNEL=12

# 무료 등급 분당 한도 회피용: 채널 요약 호출 사이 대기(초)
SLEEP_BETWEEN_CALLS=4
